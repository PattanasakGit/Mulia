# Optional overrides for `docker compose` (put them in deploy/.env, which is gitignored via /.env*
# rules in .dockerignore and your own .gitignore if needed). No secrets here: passwords and the admin
# token live in deploy/secrets/ (see README.md).
APP_PORT=3000
# Run the app as the host user that owns deploy/secrets (output of `id -u` and `id -g`).
APP_UID=1000
APP_GID=1000
# Number of proxies we own in front of the app. Caddy directly on the internet = 1.
# Caddy behind Cloudflare = 2 AND Caddy must trust Cloudflare's ranges (see README).
TRUST_PROXY_HOPS=1
DB_POOL_MAX=10
# Local directory for backup.sh; keep an off-server copy as well.
BACKUP_DIR=/var/backups/mulia
