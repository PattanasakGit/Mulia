# Caddy site block for MULIA behind Cloudflare (proxied / orange cloud). Not applied by DEV: needs root.
# Append to /etc/caddy/Caddyfile, then:  sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy
#
# Why trusted_proxies: only requests whose TCP peer is a Cloudflare edge keep the X-Forwarded-For chain
# (Cloudflare appends the real visitor IP); Caddy then appends the Cloudflare peer. The app reads the
# Nth entry from the right with TRUST_PROXY_HOPS=2 (Cloudflare + Caddy) = the real visitor. A request that
# reaches the origin directly (peer not Cloudflare) has its X-Forwarded-For replaced by Caddy, so it cannot
# forge its address. Verified locally with a stand-in proxy (see MULIA-GOLIVE-02 notes).
#
# Cloudflare ranges fetched 2026-11-19 from https://www.cloudflare.com/ips-v4 and /ips-v6.
# They change rarely; re-check them before relying on this after a few months.
# In the Cloudflare dashboard set SSL/TLS mode to "Full (strict)".
mulia.pattanasak.com {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	# MULIA-SEC-FIX: only Cloudflare edges may reach the app; direct hits on the origin IP are dropped.
	# remote_ip = the TCP peer (client_ip would trust the forwarded chain, which a direct caller can forge).
	@not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	abort @not_cloudflare

	reverse_proxy 127.0.0.1:3000 {
		trusted_proxies 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}
